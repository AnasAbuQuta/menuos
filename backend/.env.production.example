APP_NAME=MenuOS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://menu.example.com
PUBLIC_FRONTEND_URL=https://menu.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=pgsql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=menuos
DB_USERNAME=menuos
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

CACHE_STORE=database
CACHE_PREFIX=menuos_cache
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=MenuOS

SANCTUM_TOKEN_EXPIRATION=10080
SANCTUM_TOKEN_PREFIX=menuos_

SEED_DEMO_RESTAURANT=false
DEMO_OWNER_EMAIL=demo@menuos.app
DEMO_OWNER_PASSWORD=
MENUOS_BOOTSTRAP_SUPER_ADMIN_EMAIL=
